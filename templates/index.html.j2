<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Alireza &amp; Ana — Week Plan</title>
<!-- Generated by build.py from data/plan.py — do not edit by hand. -->
<style>
{{ css }}
</style>
</head>
<body>

<header>
  <h1>Week Plan · v{{ version }}</h1>
  <div class="sub">5 moments a day · weights raw/dry · weigh daily, send Sunday's 7-day average</div>
  <div class="legend"><span><i class="dotA"></i>Alireza</span><span><i class="dotN"></i>Ana</span><span class="adh" id="adh"></span></div>
</header>

<div class="days" id="dayChips"></div>

<main>
  <section class="view on" id="view-plan"><div id="dayContent"></div></section>

  <section class="view" id="view-prep">
    <p class="wk" id="prepWeek"></p>
    <div id="prepContent"></div>
    <p class="shopnote">Tick a task when it's done. The list clears every Saturday.</p>
  </section>

  <section class="view" id="view-shop">
    <div class="tripsel" id="tripSel"></div>
    <div id="firstWeek"></div>
    <div id="shopContent"></div>
    <p class="shopnote">One list in aisle order; it works in Lidl, AH or Jumbo. Quantities are computed from the plan. Ticks are saved on this phone and clear each Saturday.<br>Nothing goes in the trolley that isn't on this list. Never shop hungry.</p>
  </section>

  <section class="view" id="view-train"><div class="md" id="trainContent"></div></section>
  <section class="view" id="view-rules"><div class="md" id="rulesContent"></div></section>
</main>

<nav>
  <button class="on" data-v="plan"><span class="ic">🍽</span>Plan</button>
  <button data-v="prep"><span class="ic">🔪</span>Prep</button>
  <button data-v="shop"><span class="ic">🛒</span>Shop</button>
  <button data-v="train"><span class="ic">🏋️</span>Train</button>
  <button data-v="rules"><span class="ic">📋</span>Rules</button>
</nav>

<script>
const DATA = {{ data }};
{{ js }}
</script>
</body>
</html>
